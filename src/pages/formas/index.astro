---
import Base from '../../layouts/Base.astro';
import BotonTema from '../../compartido/BotonTema.astro';
import '../../herramientas/formas/estilos.css';
---
<Base
  titulo="Formas MC"
  descripcion="Planificador de formas en bloques para Minecraft: círculos, rectángulos, triángulos, rombos, hexágonos, esferas y cúpulas con numeración y lista de materiales."
>
<svg width="0" height="0" style="position:absolute" aria-hidden="true">
  <symbol id="i-izq" viewBox="0 0 24 24"><path d="m15 18-6-6 6-6"/></symbol>
  <symbol id="i-der" viewBox="0 0 24 24"><path d="m9 18 6-6-6-6"/></symbol>
  <symbol id="i-deshacer" viewBox="0 0 24 24"><path d="M9 14 4 9l5-5"/><path d="M4 9h10.5a5.5 5.5 0 0 1 5.5 5.5 5.5 5.5 0 0 1-5.5 5.5H11"/></symbol>
  <symbol id="i-rehacer" viewBox="0 0 24 24"><path d="m15 14 5-5-5-5"/><path d="M20 9H9.5A5.5 5.5 0 0 0 4 14.5 5.5 5.5 0 0 0 9.5 20H13"/></symbol>
  <symbol id="i-descargar" viewBox="0 0 24 24"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><path d="m7 10 5 5 5-5"/><path d="M12 15V3"/></symbol>
  <symbol id="i-subir" viewBox="0 0 24 24"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><path d="m17 8-5-5-5 5"/><path d="M12 3v12"/></symbol>
  <symbol id="i-imprimir" viewBox="0 0 24 24"><path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"/><path d="M6 9V3a1 1 0 0 1 1-1h10a1 1 0 0 1 1 1v6"/><rect x="6" y="14" width="12" height="8" rx="1"/></symbol>
  <symbol id="i-enlace" viewBox="0 0 24 24"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></symbol>
  <symbol id="i-capas" viewBox="0 0 24 24"><path d="m12 3 9 5-9 5-9-5z"/><path d="m3 13 9 5 9-5"/><path d="m3 17.5 9 5 9-5"/></symbol>
  <symbol id="i-check" viewBox="0 0 24 24"><path d="M20 6 9 17l-5-5"/></symbol>
  <symbol id="i-x" viewBox="0 0 24 24"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></symbol>
  <symbol id="i-mas" viewBox="0 0 24 24"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/><path d="M11 8v6"/><path d="M8 11h6"/></symbol>
  <symbol id="i-menos" viewBox="0 0 24 24"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/><path d="M8 11h6"/></symbol>
  <symbol id="i-ajustar" viewBox="0 0 24 24"><path d="M8 3H5a2 2 0 0 0-2 2v3"/><path d="M21 8V5a2 2 0 0 0-2-2h-3"/><path d="M3 16v3a2 2 0 0 0 2 2h3"/><path d="M16 21h3a2 2 0 0 0 2-2v-3"/></symbol>
  <symbol id="i-aviso" viewBox="0 0 24 24"><path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3"/><path d="M12 9v4"/><path d="M12 17h.01"/></symbol>
  <symbol id="i-panel" viewBox="0 0 24 24"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M9 3v18"/></symbol>
  <symbol id="i-rejilla" viewBox="0 0 24 24"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 9h18"/><path d="M3 15h18"/><path d="M9 3v18"/><path d="M15 3v18"/></symbol>
  <symbol id="i-forma" viewBox="0 0 24 24"><rect x="3" y="3" width="8" height="8" rx="1"/><circle cx="17" cy="7" r="4"/><path d="m7 14 4 7H3z"/><path d="m17 13 4 4-4 4-4-4z"/></symbol>
  <symbol id="i-cajas" viewBox="0 0 24 24"><path d="M21 8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16Z"/><path d="m3.3 7 8.7 5 8.7-5"/><path d="M12 22V12"/></symbol>
</svg>

<a class="saltar" href="#lienzo">Saltar al dibujo</a>
<header class="cab">
  <h1>Formas MC</h1>
  <p>Planificador de formas en bloques para Minecraft</p>
  <div class="cab-acciones">
    <BotonTema />
    <button type="button" id="verMenu" class="ver-menu" aria-controls="panel" aria-expanded="true"><svg class="ico" aria-hidden="true"><use href="#i-panel"/></svg><span id="verMenuTxt">Ocultar menú</span></button>
  </div>
</header>
<noscript><p class="error">Esta herramienta necesita JavaScript activado.</p></noscript>
<div id="error" class="error" role="alert" hidden></div>
<div id="nota" class="nota" role="status" aria-atomic="true" hidden>
  <svg class="ico" aria-hidden="true"><use href="#i-aviso"/></svg>
  <span id="notaTxt"></span>
</div>

<main>
  <aside class="panel" id="panel" aria-label="Controles">
    <div class="panel-cab">
      <strong>Menú</strong>
      <button type="button" id="cerrarMenu"><svg class="ico" aria-hidden="true"><use href="#i-x"/></svg>Cerrar</button>
    </div>
    <section id="secForma" aria-labelledby="t-forma">
      <h2 id="t-forma">Forma</h2>
      <div id="plantillas" class="plantillas">
        <div id="plantillaLista" class="plantillas-lista" hidden>
          <label>Plantillas
            <select id="plantillaSel"></select>
          </label>
          <div class="botones">
            <button type="button" id="plantillaAplicar" disabled><svg class="ico" aria-hidden="true"><use href="#i-check"/></svg>Aplicar</button>
            <button type="button" id="plantillaBorrar" disabled><svg class="ico" aria-hidden="true"><use href="#i-x"/></svg>Borrar</button>
          </div>
        </div>
        <p class="ayuda" id="plantillaAyuda">Guarda la forma de ahora con un nombre para recuperarla con un clic. Se guardan solo en este navegador.</p>
        <button type="button" id="plantillaGuardar" aria-expanded="false" aria-controls="plantillaCampo"><svg class="ico" aria-hidden="true"><use href="#i-descargar"/></svg>Guardar como plantilla</button>
        <div id="plantillaCampo" class="plantillas-campo" hidden>
          <label><span>Nombre de la plantilla <small>(1 a 40 caracteres)</small></span>
            <input type="text" id="plantillaNombre" maxlength="40" autocomplete="off" aria-describedby="plantillaError">
          </label>
          <p class="ayuda plantilla-error" id="plantillaError" role="alert"></p>
          <div class="botones">
            <button type="button" id="plantillaOk"><svg class="ico" aria-hidden="true"><use href="#i-check"/></svg>Guardar</button>
            <button type="button" id="plantillaCancelar"><svg class="ico" aria-hidden="true"><use href="#i-x"/></svg>Cancelar</button>
          </div>
        </div>
      </div>
      <label>Tipo
        <select id="forma"></select>
      </label>
      <div class="fila2" id="filaDims">
        <label><span><span id="lblW">Ancho</span> <small id="maxW"></small></span>
          <input type="number" id="w" min="1" max="200" inputmode="numeric"></label>
        <label id="rowH"><span>Alto <small>(máx. 200)</small></span>
          <input type="number" id="h" min="1" max="200" inputmode="numeric"></label>
      </div>
      <label class="chk" id="rowIgualar"><input type="checkbox" id="igualar"> Proporción 1:1 (alto = ancho)</label>
      <label id="rowEsfera">Variante
        <select id="esfera"></select>
      </label>
      <label id="rowOrient">Orientación
        <select id="orient"></select>
      </label>
      <div id="rowBaseY" hidden>
        <label><span>Y de la base</span>
          <input type="number" id="baseY" min="-30000000" max="30000000" step="1" aria-describedby="ayudaBaseY"></label>
        <p class="ayuda" id="ayudaBaseY">Altura de la capa 1, la que se apoya en el suelo (la ves con F3). Vacío: solo el número de capa.</p>
      </div>
      <label>Modo
        <select id="modo"><option value="relleno">Sólido</option><option value="hueco">Hueco</option></select>
      </label>
      <label id="rowGrosor"><span>Grosor del borde <small id="maxG"></small></span>
        <input type="number" id="grosor" min="1" max="50" inputmode="numeric"></label>
    </section>

    <section aria-labelledby="t-vista">
      <h2 id="t-vista">Vista</h2>
      <label class="chk"><input type="checkbox" id="rel"> Regla relativa al centro</label>
      <label class="chk"><input type="checkbox" id="tramos"> Tramos por fila y columna</label>
      <label class="chk"><input type="checkbox" id="tramosDentro"> Tramos dentro del dibujo</label>
      <label class="chk"><input type="checkbox" id="distEjes"> Distancia al centro en los ejes</label>
      <label class="chk"><input type="checkbox" id="guiasChunk"> Guías de chunk</label>
      <div class="fila2" id="filaCentroMundo" hidden>
        <label><span>X del centro</span>
          <input type="number" id="centroX" min="-30000000" max="30000000" step="1"></label>
        <label><span>Z del centro</span>
          <input type="number" id="centroZ" min="-30000000" max="30000000" step="1"></label>
      </div>
      <p class="ayuda" id="ayudaGuias" hidden></p>
      <div class="botones">
        <button type="button" id="exportar"><svg class="ico" aria-hidden="true"><use href="#i-descargar"/></svg>PNG de la capa</button>
        <button type="button" id="exportarTodas"><svg class="ico" aria-hidden="true"><use href="#i-descargar"/></svg>Todas las capas</button>
        <button type="button" id="imprimirFicha" class="ancho"><svg class="ico" aria-hidden="true"><use href="#i-imprimir"/></svg>Imprimir ficha</button>
      </div>
    </section>

    <section id="secMat" aria-labelledby="t-mat">
      <h2 id="t-mat">Materiales</h2>
      <div id="materiales"></div>
      <div id="tablaCapas"></div>
    </section>

    <section id="secProyecto" aria-labelledby="t-proyecto">
      <h2 id="t-proyecto">Proyecto</h2>
      <p class="ayuda">Guarda una copia con la forma y lo construido para moverla a otro dispositivo o recuperarla.</p>
      <div class="botones">
        <button type="button" id="guardarProyecto"><svg class="ico" aria-hidden="true"><use href="#i-descargar"/></svg>Guardar proyecto</button>
        <button type="button" id="cargarProyecto"><svg class="ico" aria-hidden="true"><use href="#i-subir"/></svg>Cargar proyecto</button>
        <button type="button" id="copiarEnlace" class="ancho"><svg class="ico" aria-hidden="true"><use href="#i-enlace"/></svg>Copiar enlace</button>
      </div>
      <input type="file" id="archivoProyecto" accept=".json,application/json" hidden>
      <label>Bloque del esquema de Litematica
        <select id="bloque"></select>
      </label>
      <label>Material del relleno
        <select id="relleno"></select>
      </label>
      <p class="ayuda" id="ayudaRelleno"></p>
      <div class="botones">
        <button type="button" id="descargarLitematica" class="ancho"><svg class="ico" aria-hidden="true"><use href="#i-capas"/></svg>Descargar para Litematica</button>
        <button type="button" id="importarLitematica" class="ancho"><svg class="ico" aria-hidden="true"><use href="#i-capas"/></svg>Importar de Litematica</button>
      </div>
      <input type="file" id="archivoLitematica" accept=".litematic" hidden>
    </section>
  </aside>

  <section class="area" id="secDibujo" aria-label="Dibujo">
    <div class="barra">
      <div id="selCapa" class="capas">
        <button type="button" class="icono" id="prev" aria-label="Capa anterior"><svg class="ico" aria-hidden="true"><use href="#i-izq"/></svg></button>
        <input type="range" id="capa" min="0" max="0" value="0" aria-label="Capa">
        <button type="button" class="icono" id="next" aria-label="Capa siguiente"><svg class="ico" aria-hidden="true"><use href="#i-der"/></svg></button>
        <strong id="capaTxt"></strong>
      </div>
      <p id="resumen"></p>
      <div class="progreso-fila">
        <div class="progreso" aria-hidden="true"><div id="barraProg"></div></div>
        <span id="progTxt"></span>
      </div>
      <div class="acciones" role="group" aria-label="Marcas de construcción">
        <button type="button" class="icono" id="deshacer" aria-label="Deshacer (Ctrl+Z)" title="Deshacer (Ctrl+Z)"><svg class="ico" aria-hidden="true"><use href="#i-deshacer"/></svg></button>
        <button type="button" class="icono" id="rehacer" aria-label="Rehacer (Ctrl+Y)" title="Rehacer (Ctrl+Y)"><svg class="ico" aria-hidden="true"><use href="#i-rehacer"/></svg></button>
        <button type="button" id="marcarCapa"><svg class="ico" aria-hidden="true"><use href="#i-check"/></svg>Marcar capa</button>
        <button type="button" id="desmarcarCapa"><svg class="ico" aria-hidden="true"><use href="#i-x"/></svg>Desmarcar capa</button>
        <button type="button" id="marcarTodo">Marcar todo</button>
        <button type="button" id="limpiar">Desmarcar todo</button>
      </div>
    </div>
    <div class="zoom" role="group" aria-label="Zoom">
      <button type="button" class="icono" id="zoomMenos" aria-label="Alejar (−)" title="Alejar (−)"><svg class="ico" aria-hidden="true"><use href="#i-menos"/></svg></button>
      <input type="range" id="zoom" min="2" max="48" aria-label="Zoom (px por bloque)">
      <button type="button" class="icono" id="zoomMas" aria-label="Acercar (+)" title="Acercar (+)"><svg class="ico" aria-hidden="true"><use href="#i-mas"/></svg></button>
      <button type="button" id="zoomAjustar" title="Ajustar a la ventana (0)"><svg class="ico" aria-hidden="true"><use href="#i-ajustar"/></svg>Ajustar</button>
      <span id="zoomTxt"></span>
    </div>
    <div class="lienzoWrap">
      <div class="reglasFijas" aria-hidden="true">
        <canvas id="reglaSup" hidden></canvas>
        <canvas id="reglaIzq" hidden></canvas>
      </div>
      <canvas id="lienzo" tabindex="0" aria-describedby="ayudaLienzo"></canvas>
    </div>
    <p id="info" class="info">Pasa el ratón por el dibujo para ver la posición de cada bloque.</p>
    <p id="ayudaLienzo" class="ayuda">
      <span class="solo-tactil"><b>Táctil:</b> toca un bloque para marcarlo o desmarcarlo · toca el número de una fila o columna para marcarla entera (si la fila es fina, acércate antes de tocarla) · desliza para moverte por el dibujo · pellizca con dos dedos para hacer zoom.</span>
      <span class="solo-raton"><b>Ratón:</b> clic o arrastre marca como construido · clic derecho desmarca · clic en el número de la regla marca la fila o columna entera · Ctrl + rueda: zoom hacia el puntero · en pantalla táctil, pellizca para hacer zoom.
      <b>Teclado</b> (con el dibujo enfocado): flechas para moverte (Mayús = 5), Espacio o Intro marca/desmarca, F marca la fila del cursor y C su columna, RePág/AvPág cambia de capa, + / − zoom, 0 ajusta.
      <b>Ctrl+Z / Ctrl+Y:</b> deshacer / rehacer.</span>
    </p>
    <ul class="leyenda">
      <li><span class="m bloque" aria-hidden="true"></span><span id="leyendaBloque">Bloque</span></li>
      <li id="leyendaRelleno" hidden><span class="m relleno" aria-hidden="true"></span>Relleno</li>
      <li><span class="m hecho" aria-hidden="true"></span>Construido (esquina marcada)</li>
      <li><span class="m centro" aria-hidden="true"></span>Franjas del centro; el recuadro dorado es el bloque central (1×1 o 2×2)</li>
      <li id="leyendaGuias" hidden><span class="m guia" aria-hidden="true"></span>Guía de chunk: frontera cada 16 bloques del mundo</li>
    </ul>
  </section>
</main>

<div id="aviso" class="aviso" role="status" aria-live="polite" hidden>
  <span id="avisoTxt"></span>
  <button type="button" id="avisoAccion" hidden>Deshacer</button>
</div>
<div id="anuncio" class="sr-only" aria-live="polite"></div>
<div id="ficha" aria-hidden="true"></div>
<nav class="navmovil" aria-label="Secciones">
  <a href="#secDibujo"><svg class="ico" aria-hidden="true"><use href="#i-rejilla"/></svg>Dibujo</a>
  <a href="#secForma"><svg class="ico" aria-hidden="true"><use href="#i-forma"/></svg>Forma</a>
  <a href="#secMat"><svg class="ico" aria-hidden="true"><use href="#i-cajas"/></svg>Materiales</a>
</nav>

<script>
  import '../../herramientas/formas/app.js';
</script>
</Base>
